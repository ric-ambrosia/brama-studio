---
/**
 * LegalPage — involucro condiviso delle pagine /legal/*.
 * Banner "bozza in validazione", tipografia legale leggibile,
 * riga "ultimo aggiornamento" e link incrociati tra le pagine legali.
 * NB: il banner andrà rimosso al go-live. Le note di lavorazione (venditore, P.IVA,
 * punti da validare con legale/commercialista) vivono SOLO come commenti sorgente
 * nelle singole pagine: non devono mai essere renderizzate.
 */
import Base from '../layouts/Base.astro';
import { LEGAL_NAV } from '../lib/site';

interface Props {
  /** Titolo H1 visibile in pagina */
  title: string;
  /** <title> del documento */
  metaTitle: string;
  description: string;
  eyebrow?: string;
}

const { title, metaTitle, description, eyebrow = 'Note legali' } = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/+$/, '');
const otherLegal = LEGAL_NAV.filter((item) => item.href !== currentPath);
---

<Base title={metaTitle} description={description} showBack>
  <article class="page legal">
    <p class="legal-draft" role="note">
      <span class="legal-draft-dot" aria-hidden="true"></span>
      Bozza in validazione legale, testo non definitivo
    </p>

    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>

    <div class="legal-body">
      <slot />
    </div>

    {/* NOTA INTERNA (non pubblicare): sostituire con la data di pubblicazione definitiva al go-live. */}
    <p class="legal-updated">Ultimo aggiornamento: luglio 2026</p>

    <nav class="legal-nav" aria-label="Altre pagine legali">
      <h2>Altre pagine legali</h2>
      <ul>
        {otherLegal.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </article>
</Base>

<style>
  .legal-draft {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 40px;
    padding: 10px 16px;
    border: 1px solid var(--line-strong);
    border-left: 2px solid var(--accent);
    border-radius: 6px;
    background: rgba(74, 147, 230, 0.08);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--ink-dim);
  }
  .legal-draft-dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .legal :global(h1) {
    font-size: clamp(34px, 5.5vw, 56px);
  }

  .legal-updated {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-mute);
  }

  .legal-nav {
    margin-top: 40px;
  }
  .legal-nav h2 {
    font-family: var(--mono);
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0 0 14px;
  }
  .legal-nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    padding: 0;
    margin: 0;
  }
  .legal-nav a {
    font-size: 14px;
    color: var(--ink-dim);
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
  }
  .legal-nav a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ===== Tipografia del corpo legale (contenuto passato via slot) ===== */

  .legal-body :global(h2) {
    font-family: var(--sans);
    font-weight: 300;
    font-size: clamp(22px, 3.2vw, 30px);
    line-height: 1.2;
    margin: 48px 0 14px;
    color: var(--ink);
  }
  .legal-body :global(h3) {
    font-family: var(--sans);
    font-weight: 500;
    font-size: 17px;
    letter-spacing: 0.01em;
    margin: 28px 0 10px;
    color: var(--ink);
  }
  .legal-body :global(p) {
    line-height: 1.75;
    color: var(--ink-dim);
    margin-bottom: 14px;
    font-size: 15.5px;
  }
  .legal-body :global(ul),
  .legal-body :global(ol) {
    margin: 0 0 18px;
    padding-left: 1.4em;
  }
  .legal-body :global(li) {
    line-height: 1.75;
    color: var(--ink-dim);
    font-size: 15.5px;
    margin-bottom: 8px;
  }
  .legal-body :global(li::marker) {
    color: var(--ink-mute);
    font-family: var(--mono);
    font-size: 0.85em;
  }
  .legal-body :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .legal-body :global(a) {
    color: var(--accent);
    border-bottom: 1px solid rgba(74, 147, 230, 0.35);
    transition: border-color 0.2s;
  }
  .legal-body :global(a:hover) {
    border-color: var(--accent);
  }
  .legal-body :global(code) {
    font-family: var(--mono);
    font-size: 0.85em;
    padding: 1px 6px;
    border-radius: 4px;
    background: rgba(240, 244, 255, 0.06);
    border: 1px solid var(--line);
  }

  /* Sommario in evidenza (es. "In sintesi" della cookie policy) */
  .legal-body :global(.legal-summary) {
    font-family: var(--sans);
    font-size: clamp(18px, 2.4vw, 21px);
    color: var(--ink);
    line-height: 1.6;
  }

  /* Tabelle: sempre dentro un contenitore scrollabile */
  .legal-body :global(.legal-table) {
    overflow-x: auto;
    margin: 8px 0 24px;
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .legal-body :global(table) {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 14px;
  }
  .legal-body :global(caption) {
    text-align: left;
    padding: 12px 14px 4px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .legal-body :global(th) {
    font-family: var(--mono);
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: left;
    color: var(--ink-mute);
    padding: 12px 14px;
    border-bottom: 1px solid var(--line-strong);
  }
  .legal-body :global(td) {
    padding: 12px 14px;
    vertical-align: top;
    line-height: 1.6;
    color: var(--ink-dim);
    border-bottom: 1px solid var(--line);
  }
  .legal-body :global(tr:last-child td) {
    border-bottom: 0;
  }

  /* Modulo tipo / blocchi citati */
  .legal-body :global(.legal-module) {
    margin: 16px 0 24px;
    padding: 24px 28px;
    border: 1px dashed var(--line-strong);
    border-radius: 8px;
    background: rgba(240, 244, 255, 0.03);
  }
  .legal-body :global(.legal-module p),
  .legal-body :global(.legal-module li) {
    font-size: 15px;
  }
  .legal-body :global(.legal-module ul) {
    list-style: none;
    padding-left: 0;
  }
  .legal-body :global(.legal-module .module-note) {
    margin-top: 12px;
    margin-bottom: 0;
    font-size: 13px;
    color: var(--ink-mute);
  }

  /* Focus visibile su tutti i link della pagina legale */
  .legal :global(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }
</style>
