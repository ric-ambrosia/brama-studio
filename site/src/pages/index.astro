---
import '../styles/tokens.css';
import '../styles/intro.css';
import { getCollection } from 'astro:content';
import { SITE } from '../lib/site';

// Slug delle opere per il redirect dei QR fisici legacy (#slug → /opera/<slug>).
const works = await getCollection('works');
const slugs = works.map((w) => w.id);

const SECTIONS = [
  { href: '/opere', label: 'Opere' },
  { href: '/shop', label: 'Shop' },
  { href: '/contatti', label: 'Contatti' },
  { href: '/esposizione', label: 'Esposizione', temp: true },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'brama',
  url: SITE.domain,
  description: SITE.descrizione,
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>brama · opere materiche</title>
    <meta
      name="description"
      content="Opere in acrilico, resina epossidica, vetro, ossidiana, oro e fibra ottica, con meccanismi nascosti che si accendono con la luce."
    />
    <link rel="canonical" href={SITE.domain} />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon-192.png" />
    <link rel="apple-touch-icon" href="/images/favicon-192.png" />
    <meta name="theme-color" content="#050a1a" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="brama" />
    <meta property="og:title" content="brama · opere materiche" />
    <meta
      property="og:description"
      content="Opere in acrilico, resina epossidica, vetro, ossidiana, oro e fibra ottica, con meccanismi nascosti che si accendono con la luce."
    />
    <meta property="og:url" content={SITE.domain} />
    <meta property="og:image" content={`${SITE.domain}/images/og-image.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="brama · opere materiche" />
    <meta
      name="twitter:description"
      content="Opere materiche in acrilico, resina, vetro, ossidiana, oro e fibra ottica."
    />
    <meta name="twitter:image" content={`${SITE.domain}/images/og-image.jpg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400&family=Fraunces:opsz,wght@9..144,200;9..144,300&family=Inter+Tight:wght@400;500&family=JetBrains+Mono:wght@400&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {/* Config del vortice (valori v1 esatti) — letti da /vertigine.js */}
    <script is:inline>
      window.__BRAMA_CONFIG__ = { density: 400, butterfly: 'glass', coreSize: 1.6, coreColor: '#1296de', overlapFade: 0.95, titleFont: 'cormorant-roman' };
      window.__brama_density = 400;
      window.__brama_coreSize = 1.6;
      window.__brama_coreColor = '#1296de';
    </script>
    {/* Redirect QR legacy: brama.studio/#<slug> → /opera/<slug>. Deve girare per primo. */}
    <script is:inline define:vars={{ slugs }}>
      (function () {
        var h = location.hash.replace(/^#/, '');
        if (!h) return;
        try { h = decodeURIComponent(h); } catch (e) { return; }
        if (slugs.indexOf(h) !== -1) location.replace('/opera/' + h);
      })();
    </script>
  </head>
  <body class="grain">
    <a class="skip-link" href="#main">Vai al contenuto</a>
    <h1 class="sr-only">brama</h1>
    <!-- logo v1 (top-left) -->
    <a class="nav-fixed" href="/" aria-label="brama, home">
      <img class="nav-sig" src="/images/signature.png" alt="brama" />
    </a>

    <!-- navigazione rapida: hamburger + overlay con le sezioni -->
    <button class="hp-burger" aria-label="Apri il menu" aria-expanded="false" aria-controls="hp-menu">
      <span class="hp-line"></span><span class="hp-line"></span><span class="hp-line"></span>
    </button>
    <nav id="hp-menu" class="hp-menu" aria-hidden="true" aria-label="Sezioni" inert>
      <ul>
        {SECTIONS.map((s) => (
          <li class={s.temp ? 'hpm-temp' : undefined}>
            <a href={s.href}>
              {s.label}
              {s.temp && <span class="hpm-temp-tag"><span class="nav-dot" aria-hidden="true"></span>fino al 9 settembre</span>}
            </a>
          </li>
        ))}
      </ul>
      <div class="hp-menu-meta">
        <a href={SITE.instagram} rel="noopener" target="_blank">Instagram</a>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
    </nav>

    <main id="main">
    <div class="intro-track">
      <!-- HERO identico alla v1: vortice + farfalla di vetro (senza corpo) + hint -->
      <section class="hero">
        <canvas id="vertigine"></canvas>
        <div class="vortex-flash" aria-hidden="true"></div>
        <div class="holo-fallback" aria-hidden="true"></div>


        <div class="hero-mark" aria-hidden="true">
          <div class="fly-shift">
            <div class="butterfly-wrap">
              <div class="butterfly-bloom"></div>
              <div class="butterfly butterfly-glass">
                <div class="wing-slot left">
                  <div class="g-wing g-wing-l">
                    <div class="shard s-a"></div>
                    <div class="shard s-c"></div>
                    <div class="shard s-d"></div>
                    <div class="shard s-e"></div>
                  </div>
                </div>
                <div class="wing-slot right">
                  <div class="g-wing g-wing-r">
                    <div class="shard s-a"></div>
                    <div class="shard s-c"></div>
                    <div class="shard s-d"></div>
                    <div class="shard s-e"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- menu: minimale ed elegante sul blu -->
        <nav class="hub" id="sezioni" aria-label="Sezioni">
          {SECTIONS.map((s) => (
            <a class={s.temp ? 'hub-item hub-temp' : 'hub-item'} href={s.href}>
              {s.label}
              {s.temp && <span class="hub-temp-tag"><span class="nav-dot" aria-hidden="true"></span>fino al 9 settembre</span>}
            </a>
          ))}
        </nav>
        <div class="hub-foot">
          <a href={SITE.instagram} rel="noopener" target="_blank">Instagram</a>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </div>

        <a class="hint-pointer" href="#sezioni" aria-label="Scorri per le sezioni">
          <span class="hint-inner">
            <span class="hint-label">scorri</span>
            <svg viewBox="0 0 24 36" aria-hidden="true">
              <path d="M 12 2 L 12 28 M 4 20 L 12 30 L 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      </section>
    </div>
    </main>

    <script is:inline src="/vertigine.js"></script>
    <script>
      import '../scripts/intro/intro.js';
      // hamburger della home: apre/chiude l'overlay con le sezioni
      const hpBurger = document.querySelector('.hp-burger');
      const hpMenu = document.getElementById('hp-menu');
      if (hpBurger && hpMenu) {
        const setOpen = (o: boolean) => {
          hpBurger.setAttribute('aria-expanded', String(o));
          hpBurger.setAttribute('aria-label', o ? 'Chiudi il menu' : 'Apri il menu');
          hpMenu.setAttribute('aria-hidden', String(!o));
          (hpMenu as HTMLElement).inert = !o;
          document.body.classList.toggle('hp-open', o);
        };
        hpBurger.addEventListener('click', () => setOpen(hpBurger.getAttribute('aria-expanded') !== 'true'));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
        hpMenu.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).tagName === 'A') setOpen(false);
        });
      }
    </script>
  </body>
</html>
