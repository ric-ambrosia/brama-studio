---
// /opera/<slug> — pagina statica di ogni opera (destinazione di Viaggio, shop e QR fisici).
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE, FEATURES } from '../../lib/site';
import {
  effectiveStatus,
  STATUS_LABEL,
  formatSize,
  formatPrice,
  byJourneyOrder,
  priceInfo,
  type Work,
} from '../../lib/works';
import {
  shippingTier,
  shippingClientConfig,
  courierAmount,
  euro,
  EU_COUNTRIES,
  DELIVERY_DAYS,
  OPTIONS,
  INSURANCE_NOTE,
  QUOTE_NOTE,
} from '../../lib/shipping';
import catalog from '../../../content-notes/images-catalog.json';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

interface Props {
  work: Work;
}

const { work } = Astro.props;
const { title, year, city, size, materials, collection, images, video, interaction, philosophy, price, model3d } =
  work.data;
const has3d = Boolean(model3d);
// Con `parti` c'è il montaggio a scroll (Battiti, sezione alta 300svh); senza,
// il visore mostra solo il meccanismo che gira (Clessidra, altezza normale).
const hasAssembly = Boolean(model3d?.parti);
const prices = priceInfo(work.data);

const { Content } = await render(work);
const hasStory = Boolean(work.body && work.body.trim().length > 0);

// Stato effettivo: frontmatter + stato di vendita runtime (KV) al momento della build.
const status = await effectiveStatus(work);

// --- Immagini: dimensioni e thumb dal catalogo generato ------------------------
type CatalogWork = {
  slug: string;
  image?: { file: string; width: number; height: number };
  thumbs?: { file: string; width: number; height: number }[];
};
const catalogEntry = (catalog.works as CatalogWork[]).find((c) => c.slug === work.id);
const mainImage = images.main ?? null;
const imgWidth = catalogEntry?.image?.width;
const imgHeight = catalogEntry?.image?.height;

const thumbSources = (catalogEntry?.thumbs ?? []).map((t) => ({
  url: `/images/thumbs/${t.file.split('/').pop()}`,
  width: t.width,
}));
const srcset =
  mainImage && imgWidth
    ? [...thumbSources.map((t) => `${t.url} ${t.width}w`), `${mainImage} ${imgWidth}w`].join(', ')
    : undefined;
const sizesAttr = '(min-width: 901px) min(56vw, 800px), calc(100vw - 48px)';

const altText = `«${title}», opera di brama in ${materials.join(', ')}${
  size ? `, ${formatSize(size)}` : ''
} (${year}).`;

// --- Navigazione del Viaggio ---------------------------------------------------
const allWorks = await getCollection('works');
const coreWorks = allWorks.filter((w) => w.data.collection === 'core').sort(byJourneyOrder);
const coreIndex = coreWorks.findIndex((w) => w.id === work.id);
const prevWork = collection === 'core' && coreIndex > 0 ? coreWorks[coreIndex - 1] : null;
const nextWork =
  collection === 'core' && coreIndex >= 0 && coreIndex < coreWorks.length - 1
    ? coreWorks[coreIndex + 1]
    : null;

// --- Emblema scenico -----------------------------------------------------------
// Lo stesso asset a inchiostro che fa da protagonista/quinta nella tappa del
// Viaggio (vedi content-notes/art-direction.md §4) torna qui come sigillo
// discreto: la pagina è la "scheda" della scena già attraversata.
const SCENE_EMBLEM: Record<string, string> = {
  vertigine: 'vertigine-vortice',
  abbandono: 'abbandono-figura',
  fuga: 'fuga-figura',
  'ti-devo-lasciare': 'lasciarti-mano',
  'pugno-nel-tempo': 'pugno-emblema',
  depressione: 'depressione-occhio',
  'la-casa-di-mike': 'mike-casa',
  lu: 'lu-mezzaluna',
  'avventura-di-una-vita': 'avventura-clessidra',
};
const emblem = SCENE_EMBLEM[work.id] ?? null;
// Se l'opera non ha foto (avventura-di-una-vita), l'emblema diventa il
// protagonista del riquadro immagine: niente doppio timbro nella colonna dati.
const showSigillo = Boolean(emblem && mainImage);

// --- Testi e metadati ----------------------------------------------------------
const COLLECTION_LABEL: Record<typeof collection, string> = {
  core: 'Il Viaggio',
  emozioni: 'Collezione Emozioni',
  disegni: 'Disegni',
  cinetica: 'Serie cinetica',
};
const pad2 = (n: number) => String(n).padStart(2, '0');
const eyebrow =
  collection === 'core' && work.data.journey.featured
    ? `Il Viaggio · Tappa ${pad2(work.data.journey.order)} / ${pad2(coreWorks.length)}`
    : work.data.series
      ? `${work.data.series} · ${COLLECTION_LABEL[collection]}`
      : COLLECTION_LABEL[collection];

// Taglia al confine di parola, chiudendo su punteggiatura pulita (niente parole spezzate).
const clip = (s: string, max: number) => {
  if (s.length <= max) return s;
  const cut = s.slice(0, max);
  const at = cut.lastIndexOf(' ');
  const base = at > max * 0.6 ? cut.slice(0, at) : cut;
  return base.replace(/[\s,;:.–-]+$/, '') + '…';
};
const bodyText = (work.body ?? '')
  .replace(/^\s*[-*]\s+/gm, '') // togli i marcatori di lista markdown
  .replace(/[#*_>`[\]]/g, '')
  .replace(/\s+/g, ' ')
  .trim();
const description = bodyText
  ? clip(bodyText, 155)
  : `${title} (${year}${city ? `, ${city}` : ''}), opera in ${materials.join(
      ', '
    )} della collezione ${collection === 'core' ? 'principale' : collection} di brama.`;

const canonical = new URL(`/opera/${work.id}`, SITE.domain).href;

// --- Acquisto ------------------------------------------------------------------
// Vendita gestita SOLO su richiesta: si mostra il prezzo e le opzioni di
// consegna/ritiro, ma si contatta il venditore con il modulo (niente checkout
// online). Il pagamento diretto Stripe per le Emozioni è dietro il flag
// `directCheckout` (per ora spento, riaccendibile in config/features.json).
const isEmoz = collection === 'emozioni';
const canBuy = status === 'available' && price > 0 && isEmoz && FEATURES.directCheckout;
const requestBuy = status === 'available' && price > 0 && !canBuy;
const askPrice = status === 'available' && price <= 0;

// Spedizione: taglia dedotta dall'opera + config per il calcolatore lato client.
const shipTier = shippingTier(work.data);
const shipCfg = shippingClientConfig(shipTier);
const shipInitIT = courierAmount(shipTier, 'IT'); // vista iniziale = Italia (progressive enhancement)

const mailtoPrice = `mailto:${SITE.email}?subject=${encodeURIComponent(
  `Richiesta prezzo: ${title}`
)}`;
const mailtoRequest = `mailto:${SITE.email}?subject=${encodeURIComponent(
  `Richiesta informazioni: ${title}`
)}&body=${encodeURIComponent(
  `Vorrei qualche informazione su «${title}»${size ? ` (${formatSize(size)})` : ''}.\n\n` +
    `Nome:\n`
)}`;

// --- JSON-LD -------------------------------------------------------------------
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'VisualArtwork',
  name: title,
  url: canonical,
  dateCreated: String(year),
  artMedium: materials.join(', '),
  creator: { '@type': 'Organization', name: 'brama', url: SITE.domain },
};
if (size) {
  jsonLd.width = { '@type': 'Distance', name: `${size.w} cm` };
  jsonLd.height = { '@type': 'Distance', name: `${size.h} cm` };
}
if (mainImage) jsonLd.image = new URL(mainImage, SITE.domain).href;
if (price > 0 && (status === 'available' || status === 'sold')) {
  jsonLd.offers = {
    '@type': 'Offer',
    price: price,
    priceCurrency: 'EUR',
    availability:
      status === 'available' ? 'https://schema.org/InStock' : 'https://schema.org/SoldOut',
    url: canonical,
  };
}
---

<Base
  title={`${title} · brama`}
  description={description}
  ogImage={mainImage ?? undefined}
  jsonLd={jsonLd}
  showBack
  backHref="/shop"
>
  <article class="page page-wide opera" data-opera data-slug={work.id} data-status={status}>
    <div class="opera-split">
      <figure class:list={['opera-media', collection === 'emozioni' && 'opera-media--cap']}>
        {
          video ? (
            <video
              class="opera-video"
              src={video}
              poster={mainImage ?? undefined}
              autoplay
              loop
              muted
              playsinline
              preload="metadata"
              aria-label={`${title}, il movimento in loop`}
            />
          ) : mainImage ? (
            <button
              type="button"
              class:list={['opera-zoom', collection === 'cinetica' && 'is-plain']}
              data-lightbox-open
              aria-haspopup="dialog"
              aria-label={`Ingrandisci l'immagine di «${title}»`}
            >
              <img
                src={mainImage}
                srcset={srcset}
                sizes={srcset ? sizesAttr : undefined}
                width={imgWidth}
                height={imgHeight}
                alt={altText}
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
              <span class="opera-zoom-hint" aria-hidden="true">Ingrandisci</span>
            </button>
          ) : (
            <div class="opera-noimage" aria-hidden="true">
              {emblem && (
                <span class="opera-noimage-ink" style={`--m:url('/viaggio/${emblem}.webp')`} />
              )}
              <span class="opera-noimage-title">{title}</span>
            </div>
          )
        }
        {
          !mainImage && (
            <figcaption class="opera-noimage-note">
              Documentazione fotografica in preparazione. L'opera è raccolta tra le{' '}
              <a href="/opere">opere</a>.
            </figcaption>
          )
        }
      </figure>

      <div class="opera-data">
        {
          showSigillo && (
            <span
              class="opera-sigillo"
              style={`--m:url('/viaggio/${emblem}.webp')`}
              aria-hidden="true"
            />
          )
        }
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="opera-title">{title}</h1>
        <p class="opera-meta">
          <span>{year}</span>
          {city && <span aria-hidden="true"> · </span>}
          {city && <span>{city}</span>}
          {size && <span aria-hidden="true"> · </span>}
          {size && <span>{formatSize(size)}</span>}
        </p>
        {materials.length > 0 && <p class="opera-materials">{materials.join(' · ')}</p>}
        <p class="opera-status">
          <span class={`status-badge is-${status}`} data-status-badge>{STATUS_LABEL[status]}</span>
        </p>

        {
          hasStory && (
            <div class="opera-story">
              <Content />
            </div>
          )
        }

        {
          interaction && (
            <section class="opera-interaction" aria-labelledby="interaction-title">
              <h2 id="interaction-title" class="opera-interaction-title">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="3.2" />
                  <path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M18.7 5.3l-2.1 2.1M7.4 16.6l-2.1 2.1" />
                </svg>
                Come interagire
              </h2>
              <p>{interaction}</p>
            </section>
          )
        }

        {philosophy && <p class="opera-philosophy">{philosophy}</p>}

        {
          canBuy && (
            <section class="opera-buy" aria-labelledby="buy-title" data-buy>
              <h2 id="buy-title" class="opera-buy-title">Acquisto</h2>
              <p class="opera-price">
                {prices.full && <span class="opera-price-full">{prices.full}</span>}
                <span class="opera-price-now">{prices.current}</span>
                {prices.discountPct && <span class="opera-price-tag">-{prices.discountPct}%</span>}
              </p>
              <div class="ship-calc" data-ship data-cfg={JSON.stringify(shipCfg)}>
                <label class="ship-dest">
                  <span>Spedizione verso</span>
                  <select data-ship-country aria-label="Paese di destinazione">
                    <option value="IT" selected>Italia</option>
                    <optgroup label="Unione Europea">
                      {EU_COUNTRIES.map((c) => <option value={c.code}>{c.name}</option>)}
                    </optgroup>
                    <option value="WORLD">Resto del mondo</option>
                  </select>
                </label>
                <fieldset class="ship-zones">
                  <legend>Consegna</legend>
                  <label class="ship-option">
                    <input type="radio" name="ship" value="courier" checked data-ship-courier />
                    <span class="ship-zone">Corriere assicurato</span>
                    <span class="ship-rate" data-rate-courier>
                      {shipInitIT != null
                        ? `${euro(shipInitIT)} · da ${DELIVERY_DAYS.IT[0]} a ${DELIVERY_DAYS.IT[1]} gg`
                        : 'su preventivo'}
                    </span>
                  </label>
                  <label class="ship-option">
                    <input type="radio" name="ship" value="pickup" />
                    <span class="ship-zone">{OPTIONS.pickup.label}</span>
                    <span class="ship-rate">Gratis</span>
                  </label>
                  <label class="ship-option" data-ship-hand>
                    <input type="radio" name="ship" value="handMilan" />
                    <span class="ship-zone">{OPTIONS.handMilan.label}</span>
                    <span class="ship-rate">{euro(OPTIONS.handMilan.price)}</span>
                  </label>
                </fieldset>
                <p class="ship-note" data-ship-quote hidden>{QUOTE_NOTE}</p>
                <p class="ship-note">{INSURANCE_NOTE}</p>
              </div>
              <button type="button" class="buy-btn" data-buy-btn>Acquista</button>
            </section>
          )
        }

        {
          requestBuy && (
            <section class="opera-buy" aria-labelledby="buy-title" data-buy>
              <h2 id="buy-title" class="opera-buy-title">Informazioni</h2>
              <p class="opera-price">
                {prices.full && <span class="opera-price-full">{prices.full}</span>}
                <span class="opera-price-now">{prices.current}</span>
                {prices.discountPct && <span class="opera-price-tag">-{prices.discountPct}%</span>}
              </p>
              <p class="opera-request-lead">
                Ti interessa quest'opera? Lasciami i tuoi dati: ricevi subito una conferma e ti
                scrivo io con tutte le informazioni.
              </p>

              <details class="opera-request" data-request>
                <summary class="buy-btn opera-request-toggle">Richiedi informazioni</summary>
                <form class="opera-request-form" data-request-form data-slug={work.id} novalidate>
                  <div class="req-grid">
                    <label class="req-field">
                      <span>Nome</span>
                      <input name="nome" type="text" autocomplete="given-name" required />
                    </label>
                    <label class="req-field">
                      <span>Cognome</span>
                      <input name="cognome" type="text" autocomplete="family-name" required />
                    </label>
                  </div>
                  <label class="req-field">
                    <span>Email</span>
                    <input name="email" type="email" autocomplete="email" inputmode="email" required />
                  </label>
                  <label class="req-field">
                    <span>
                      Messaggio <em>(facoltativo)</em>
                    </span>
                    <textarea name="messaggio" rows="3" maxlength="2000" />
                  </label>
                  <label class="req-consent">
                    <input name="consenso" type="checkbox" required />
                    <span>
                      Ho letto l'
                      <a href="/legal/privacy" target="_blank" rel="noopener">
                        informativa privacy
                      </a>{' '}
                      e acconsento al trattamento dei dati per essere ricontattato.
                    </span>
                  </label>
                  <button type="submit" class="buy-btn" data-request-submit>
                    Invia richiesta
                  </button>
                  <p class="req-error" data-request-error role="alert" hidden />
                </form>
              </details>

              <noscript>
                <a class="buy-btn" href={mailtoRequest}>Richiedi informazioni via email</a>
              </noscript>

              <div class="opera-ship-info">
                <p class="opera-ship-label">Come viaggiano le opere</p>
                <ul class="opera-ship-opts">
                  <li>Corriere assicurato e tracciato, ovunque</li>
                  <li>Ritiro all'esposizione (The Seed, Milano)</li>
                  <li>Consegna a mano a Milano e dintorni</li>
                </ul>
              </div>

              <p class="ship-note">Ti rispondo io da {SITE.email} con tutte le informazioni.</p>
            </section>
          )
        }

        {
          askPrice && (
            <section class="opera-buy" aria-labelledby="buy-title" data-buy>
              <h2 id="buy-title" class="opera-buy-title">Informazioni</h2>
              <p class="opera-price">{formatPrice(price)}</p>
              <a class="buy-btn" href={mailtoPrice}>Richiedi il prezzo</a>
              <p class="ship-note">
                Rispondiamo da {SITE.email} con prezzo, tempi e dettagli di spedizione.
              </p>
            </section>
          )
        }

        <p class="opera-live" data-buy-msg role="status" hidden></p>

        {
          status === 'available' && (
            <>
              <p class="opera-note" data-note-sold hidden>
                Quest'opera è stata venduta, ma resta parte del racconto.{' '}
                <a href="/shop">Le opere disponibili sono nello shop</a>.
              </p>
              <p class="opera-note" data-note-reserved hidden>
                Quest'opera è momentaneamente riservata: qualcuno sta completando l'acquisto. Se la
                transazione non si conclude, tornerà disponibile qui.
              </p>
            </>
          )
        }

        {
          status === 'sold' && (
            <p class="opera-note">
              Le opere vendute restano parte del racconto.{' '}
              <a href="/shop">Le opere disponibili sono nello shop</a>.
            </p>
          )
        }

        {
          status === 'coming-soon' && (
            <p class="opera-note">
              In lavorazione: quest'opera sta prendendo forma nello studio. Quando sarà pronta,
              apparirà qui e nel <a href="/shop">nostro shop</a>.
            </p>
          )
        }
      </div>
    </div>

    {has3d && (
      <>
        <h2 class="opera-3d-heading">Il meccanismo</h2>
        <section
          class:list={['opera-3d', !hasAssembly && 'is-simple']}
          data-paura-section
          aria-label={`${title}, il meccanismo in 3D`}
        >
          <div class="opera-3d-stage" data-paura data-parti={model3d?.parti} data-animato={model3d?.animato}>
            <canvas class="opera-3d-canvas" data-paura-canvas></canvas>
            <p class="opera-3d-hint">
              {hasAssembly ? 'Trascina per ruotare · scorri per montare e smontare' : 'Trascina per ruotare'}
            </p>
            <p class="opera-3d-progress" data-paura-progress>Caricamento 0%</p>
          </div>
        </section>
      </>
    )}

    <nav class="opera-nav" aria-label="Navigazione tra le opere">
      {
        collection === 'core' ? (
          <>
            <div class="opera-nav-cell prev">
              {prevWork && (
                <a href={`/opera/${prevWork.id}`} rel="prev">
                  <span class="opera-nav-label">← Tappa precedente</span>
                  <span class="opera-nav-title">{prevWork.data.title}</span>
                </a>
              )}
            </div>
            <div class="opera-nav-cell center">
              <a href="/">Il Viaggio</a>
            </div>
            <div class="opera-nav-cell next">
              {nextWork && (
                <a href={`/opera/${nextWork.id}`} rel="next">
                  <span class="opera-nav-label">Prossima tappa →</span>
                  <span class="opera-nav-title">{nextWork.data.title}</span>
                </a>
              )}
            </div>
          </>
        ) : (
          <div class="opera-nav-cell center">
            <a href="/opere">← Torna alle opere</a>
          </div>
        )
      }
    </nav>
  </article>

  {
    mainImage && (
      <div
        class="lightbox"
        data-lightbox
        hidden
        role="dialog"
        aria-modal="true"
        aria-label={`Immagine ingrandita di «${title}»`}
      >
        <div
          class="lightbox-scroll"
          data-lightbox-scroll
          tabindex="0"
          aria-label="Area immagine: clic per ingrandire, frecce per scorrere"
        >
          <img
            src={mainImage}
            width={imgWidth}
            height={imgHeight}
            alt={altText}
            loading="lazy"
            decoding="async"
            draggable="false"
            data-lightbox-img
          />
        </div>
        <button type="button" class="lightbox-close" data-lightbox-close aria-label="Chiudi (Esc)">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M5 5l14 14M19 5L5 19" />
          </svg>
        </button>
        <p class="lightbox-hint" aria-hidden="true">clic sull'immagine per ingrandire · Esc per chiudere</p>
      </div>
    )
  }
</Base>

<style>
  .opera {
    padding-bottom: 72px;
  }

  /* --- ingresso: fade/rise sobrio, una cosa per volta --------------------- */
  /* prefers-reduced-motion: il reset globale in tokens.css porta la durata a
     0.01ms, con fill `both` la pagina appare direttamente nello stato finale. */
  @keyframes opera-enter {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .opera-media {
    animation: opera-enter 0.55s cubic-bezier(0.32, 0.72, 0, 1) both;
  }
  /* Emozioni: la foto sorgente e' ~885px; la limito cosi' non viene ingrandita e sgranata */
  .opera-media--cap { max-width: 460px; margin-inline: auto; }
  .opera-data {
    animation: opera-enter 0.55s cubic-bezier(0.32, 0.72, 0, 1) 0.1s both;
  }
  .opera-nav {
    animation: opera-enter 0.55s cubic-bezier(0.32, 0.72, 0, 1) 0.18s both;
  }
  .opera-split {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  @media (max-width: 900px) {
    .opera-split {
      grid-template-columns: 1fr;
    }
  }

  /* --- opera cinetica: hero 3D a tutta larghezza ------------------------- */
  .opera-split.is-solo {
    grid-template-columns: 1fr;
    max-width: 760px;
    margin: 0 auto;
  }
  .opera-3d-heading {
    font-family: var(--sans);
    font-weight: 300;
    font-size: clamp(20px, 3vw, 30px);
    letter-spacing: 0.01em;
    text-align: center;
    margin: clamp(48px, 9vh, 110px) 0 6px;
    color: var(--ink);
  }
  .opera-3d {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-bottom: clamp(40px, 7vh, 96px);
    min-height: 300svh;              /* alto: si può restare a montare/smontare con calma */
    background: #e7e8ec;
  }
  .opera-3d-stage { position: sticky; top: 0; width: 100%; height: 100svh; overflow: hidden; }
  /* meccanismo semplice (senza montaggio a scroll): riquadro di altezza normale */
