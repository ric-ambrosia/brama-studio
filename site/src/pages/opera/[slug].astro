<script>
  // ============================================================================
  // Lightbox: click → overlay a schermo intero; click sull'immagine → zoom 1:1
  // con pan via scroll (rotella/trackpad/touch); Esc, X o click sul fondo → chiude.
  // ============================================================================
  const lightbox = document.querySelector<HTMLElement>('[data-lightbox]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-lightbox-open]');
  if (lightbox && openBtn) {
    const scroller = lightbox.querySelector<HTMLElement>('[data-lightbox-scroll]')!;
    const img = lightbox.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const closeBtn = lightbox.querySelector<HTMLButtonElement>('[data-lightbox-close]')!;
    let lastFocus: HTMLElement | null = null;

    const isOpen = () => !lightbox.hidden;

    const open = () => {
      lastFocus = document.activeElement as HTMLElement;
      lightbox.hidden = false;
      lightbox.classList.remove('zoomed');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    };

    const close = () => {
      lightbox.hidden = true;
      lightbox.classList.remove('zoomed');
      document.body.style.overflow = '';
      lastFocus?.focus();
    };

    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);

    // Click sul fondo (fuori dall'immagine) chiude; click sull'immagine fa zoom.
    scroller.addEventListener('click', (e) => {
      if (e.target === scroller) close();
    });

    img.addEventListener('click', (e) => {
      const zoomingIn = !lightbox.classList.contains('zoomed');
      if (zoomingIn) {
        const rect = img.getBoundingClientRect();
        const rx = (e.clientX - rect.left) / rect.width;
        const ry = (e.clientY - rect.top) / rect.height;
        lightbox.classList.add('zoomed');
        // Centra lo scroll sul punto cliccato, dopo il reflow.
        requestAnimationFrame(() => {
          scroller.scrollLeft = img.offsetWidth * rx - scroller.clientWidth / 2;
          scroller.scrollTop = img.offsetHeight * ry - scroller.clientHeight / 2;
        });
      } else {
        lightbox.classList.remove('zoomed');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }
      // Focus circoscritto al dialog (due soli elementi focalizzabili).
      if (e.key === 'Tab') {
        const focusables = [closeBtn, scroller];
        const i = focusables.indexOf(document.activeElement as HTMLElement);
        const nextIdx = e.shiftKey
          ? (i - 1 + focusables.length) % focusables.length
          : (i + 1) % focusables.length;
        e.preventDefault();
        focusables[nextIdx].focus();
      }
    });
  }

  // ============================================================================
  // Stato di vendita runtime + checkout.
  // La pagina è statica: all'idratazione verifichiamo /api/state e, se l'opera
  // è stata venduta o riservata dopo l'ultimo deploy, sostituiamo il CTA.
  // ============================================================================
  const root = document.querySelector<HTMLElement>('[data-opera]');
  if (root && root.dataset.status === 'available') {
    const slug = root.dataset.slug!;
    const badge = root.querySelector<HTMLElement>('[data-status-badge]');
    const buyBox = root.querySelector<HTMLElement>('[data-buy]');
    const msg = root.querySelector<HTMLElement>('[data-buy-msg]');
    const noteSold = root.querySelector<HTMLElement>('[data-note-sold]');
    const noteReserved = root.querySelector<HTMLElement>('[data-note-reserved]');

    const showMsg = (text: string) => {
      if (!msg) return;
      msg.textContent = text;
      msg.hidden = false;
    };

    const applyState = (state: string) => {
      if (state !== 'sold' && state !== 'reserved') return;
      if (badge) {
        badge.textContent = state === 'sold' ? 'Venduto' : 'Riservato';
        badge.className = badge.className.replace(/is-[a-z-]+/, `is-${state}`);
      }
      buyBox?.remove();
      if (state === 'sold') noteSold?.removeAttribute('hidden');
      else noteReserved?.removeAttribute('hidden');
    };

    const fetchState = async (): Promise<string | null> => {
      try {
        const res = await fetch(`/api/state?slug=${encodeURIComponent(slug)}`);
        if (!res.ok) return null;
        const data = await res.json();
        return typeof data.state === 'string' ? data.state : null;
      } catch {
        return null;
      }
    };

    // Verifica iniziale all'idratazione.
    fetchState().then((state) => {
      if (state) applyState(state);
    });

    // Calcolatore spedizione + Checkout (presenti solo se il prezzo è definito).
    const shipRoot = root.querySelector<HTMLElement>('[data-ship]');
    const buyBtn = root.querySelector<HTMLButtonElement>('[data-buy-btn]');
    if (shipRoot && buyBtn) {
      const cfg = JSON.parse(shipRoot.dataset.cfg || '{}');
      const countrySel = shipRoot.querySelector<HTMLSelectElement>('[data-ship-country]')!;
      const courierInput = shipRoot.querySelector<HTMLInputElement>('[data-ship-courier]')!;
      const rateEl = shipRoot.querySelector<HTMLElement>('[data-rate-courier]')!;
      const handRow = shipRoot.querySelector<HTMLElement>('[data-ship-hand]')!;
      const handInput = handRow.querySelector<HTMLInputElement>('input')!;
      const quoteNote = shipRoot.querySelector<HTMLElement>('[data-ship-quote]')!;
      const mailtoQuote = `mailto:riccardo@brama.studio?subject=${encodeURIComponent('Preventivo spedizione ' + slug)}`;
      const euro = (c: number) =>
        new Intl.NumberFormat('it-IT', {
          style: 'currency',
          currency: 'EUR',
          maximumFractionDigits: c % 100 === 0 ? 0 : 2,
        }).format(c / 100);
      const zoneOf = (cc: string) => (cc === 'IT' ? 'IT' : (cfg.eu || []).includes(cc) ? 'EU' : 'WORLD');
      const state = { country: 'IT', method: 'courier', quote: false };
      const refresh = () => {
        const country = countrySel.value;
        const zone = zoneOf(country);
        const rate = cfg.rates ? cfg.rates[zone] : null;
        if (rate == null) {
          rateEl.textContent = 'su preventivo';
        } else {
          const d = cfg.days[zone];
          rateEl.textContent = `${euro(rate)} · da ${d[0]} a ${d[1]} gg`;
        }
        // consegna a mano solo in Italia
        handRow.hidden = zone !== 'IT';
        if (zone !== 'IT' && handInput.checked) courierInput.checked = true;
        const method =
          shipRoot.querySelector<HTMLInputElement>('input[name="ship"]:checked')?.value || 'courier';
        const quote = method === 'courier' && rate == null;
        quoteNote.hidden = !quote;
        state.country = country;
        state.method = method;
        state.quote = quote;
        buyBtn.textContent = quote ? 'Richiedi preventivo' : 'Acquista';
      };
      countrySel.addEventListener('change', refresh);
      shipRoot
        .querySelectorAll<HTMLInputElement>('input[name="ship"]')
        .forEach((m) => m.addEventListener('change', refresh));
      refresh();

      buyBtn.addEventListener('click', async () => {
        if (state.quote) {
          window.location.href = mailtoQuote;
          return;
        }
        const label = buyBtn.textContent;
        buyBtn.disabled = true;
        buyBtn.textContent = 'Apertura del checkout…';
        try {
          const res = await fetch('/api/checkout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug, country: state.country, method: state.method }),
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok && data.url) {
            window.location.href = data.url;
            return;
          }
          if (res.status === 409) {
            showMsg(
              "Quest'opera è appena stata riservata da qualcun altro. Se la transazione non si conclude, tornerà disponibile qui a breve."
            );
            const state = await fetchState();
            applyState(state ?? 'reserved');
            return;
          }
          showMsg(
            'Non è stato possibile aprire il checkout. Riprova tra qualche istante o scrivi a riccardo@brama.studio.'
          );
        } catch {
          showMsg(
            'Non è stato possibile aprire il checkout. Verifica la connessione e riprova, oppure scrivi a riccardo@brama.studio.'
          );
        }
        buyBtn.disabled = false;
        buyBtn.textContent = label;
      });
    }

    // Modulo "richiesta d'acquisto" per le opere grandi (nessun checkout diretto):
    // invio i dati a /api/request-buy, poi sostituisco il form con la conferma.
    const reqForm = root.querySelector<HTMLFormElement>('[data-request-form]');
    if (reqForm) {
      const submitBtn = reqForm.querySelector<HTMLButtonElement>('[data-request-submit]')!;
      const errEl = reqForm.querySelector<HTMLElement>('[data-request-error]')!;
      reqForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        errEl.hidden = true;
        if (!reqForm.reportValidity()) return;
        const fd = new FormData(reqForm);
        const payload = {
          slug: reqForm.dataset.slug,
          nome: String(fd.get('nome') || '').trim(),
          cognome: String(fd.get('cognome') || '').trim(),
          email: String(fd.get('email') || '').trim(),
          messaggio: String(fd.get('messaggio') || '').trim(),
          consenso: fd.get('consenso') === 'on',
        };
        const label = submitBtn.textContent;
        submitBtn.disabled = true;
        submitBtn.textContent = 'Invio…';
        try {
          const res = await fetch('/api/request-buy', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok && data.ok) {
            const done = document.createElement('div');
            done.className = 'opera-request-done';
            const h = document.createElement('p');
            h.className = 'req-done-title';
            h.textContent = 'Richiesta inviata.';
            const p = document.createElement('p');
            p.textContent =
              'Ti ho mandato una conferma via email. Ti scrivo io a breve da riccardo@brama.studio con tutte le informazioni.';
            done.append(h, p);
            const details = reqForm.closest('[data-request]');
            (details || reqForm).replaceWith(done);
            return;
          }
          errEl.textContent =
            typeof data.error === 'string'
              ? data.error
              : 'Non è stato possibile inviare la richiesta. Riprova o scrivi a riccardo@brama.studio.';
          errEl.hidden = false;
        } catch {
          errEl.textContent =
            'Non è stato possibile inviare la richiesta. Verifica la connessione e riprova, oppure scrivi a riccardo@brama.studio.';
          errEl.hidden = false;
        }
        submitBtn.disabled = false;
        submitBtn.textContent = label;
      });
    }
  }

  // Visore 3D per le opere cinetiche (campo model3d): three.js + i GLB si
  // caricano solo su questa pagina, con barra di progresso.
  const paura3d = document.querySelector<HTMLElement>('[data-paura]');
  if (paura3d) {
    import('../../scripts/paura/paura.js')
      .then((m) => m.initPaura(paura3d))
      .catch((err) => console.error('paura', err));
  }
</script>
