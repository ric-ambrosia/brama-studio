---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

type Work = CollectionEntry<'works'>;

const works = await getCollection('works');

// — Archive Collection Emozioni (2021): ordine alfabetico, indice progressivo.
const emozioni = works
  .filter((w) => w.data.collection === 'emozioni')
  .sort(
    (a, b) =>
      a.data.title.localeCompare(b.data.title, 'it') || a.id.localeCompare(b.id)
  );

// Un'emozione linka /opera/<slug> solo se ha contenuto reale: immagine o descrizione.
const hasContent = (w: Work) =>
  Boolean(w.data.images.main || (w.body && w.body.trim().length > 0));

// Costellazione: ogni parola è una stella con magnitudine (grandezza) e una
// deriva verticale. Tutto deterministico, seminato dallo slug: nessun random.
const starOf = (id: string) => {
  let h = 7;
  for (const ch of id) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
  const roll = h % 100;
  const mag = roll < 14 ? 3 : roll < 40 ? 2 : roll < 72 ? 1 : 0;
  const dy = (((h >>> 4) % 25) - 12) * 1; // -12..12 px
  return { mag, dy };
};

// — Disegni: gruppi della collection, resi col loro corpo markdown.
const disegni = works
  .filter((w) => w.data.collection === 'disegni')
  .sort((a, b) => a.id.localeCompare(b.id));

const disegniRendered = await Promise.all(
  disegni.map(async (w) => {
    const { Content } = await render(w);
    return { work: w, Content };
  })
);

// — Tavole del portfolio segnate come territori di disegno nel catalogo immagini.
//   Tutte 2304×1296. La tavola di chiusura (page-16) apre la sequenza.
const plates = [
  {
    src: '/portfolio/page-16.jpg',
    lead: true,
    alt: 'Tavola di chiusura del portfolio: disegno a pennarello a tutta altezza di una figura coronata affacciata a una finestra, con coperta a scacchi, bussola e vegetazione stilizzata.',
    caption: 'La figura coronata alla finestra — coperta a scacchi, bussola, vegetazione. Tavola di chiusura del portfolio.',
  },
  {
    src: '/portfolio/page-01.jpg',
    lead: false,
    alt: 'Copertina del portfolio: creatura alata geometrica disegnata a pennarello su fondo bianco, accanto al vortice blu di Vertigine.',
    caption: 'La creatura alata della copertina, di fronte al vortice di Vertigine.',
  },
  {
    src: '/portfolio/page-03.jpg',
    lead: false,
    alt: 'Pagina d’indice del portfolio: filigrana chiara di un grande disegno a pennarello con macchine, tubi e frammenti geometrici.',
    caption: 'Macchine, tubi e frammenti geometrici: la filigrana sotto l’indice.',
  },
  {
    src: '/portfolio/page-06.jpg',
    lead: false,
    alt: 'Scheda dell’opera Fuggire: disegno a pennarello con figura alata, lettere ESC e reticolo di linee, accanto al quadro in acrilico rosso e nero.',
    caption: 'Figura alata, lettere ESC, reticolo di linee — al margine di Fuggire.',
  },
  {
    src: '/portfolio/page-07.jpg',
    lead: false,
    alt: 'Scheda dell’opera Pugno nel tempo: disegno a pennarello con lune cornute, triangoli e pattern in bianco e nero.',
    caption: 'Lune cornute, triangoli e pattern — al margine di Pugno nel tempo.',
  },
];

// — Emblemi minori descritti nel catalogo: disegni che non occupano una tavola.
const emblems = [
  { sign: 'Il pugnale-imbarcazione', place: 'sotto il titolo di Vertigine' },
  { sign: 'La piccola figura umana', place: 'al margine di Abbandono' },
  { sign: 'L’occhio con sopracciglio', place: 'accanto a Depressione' },
  { sign: 'Le mezzelune', place: 'agli angoli di Lasciarti andare' },
];

const title = 'Archivio — Emozioni (2021) e disegni | brama';
const description =
  'L’archivio di brama: le tele in acrilico dell’Archive Collection Emozioni (2021), una per ogni emozione, e il mondo grafico in bianco e nero dei disegni a pennarello. Consultazione, non vendita.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Archivio brama',
  description,
  url: 'https://brama.studio/archivio',
  inLanguage: 'it',
  hasPart: [
    {
      '@type': 'CreativeWork',
      name: 'Archive Collection — Emozioni',
      dateCreated: '2021',
      artMedium: 'Acrilico su tela',
      description:
        'Trentatré tele in acrilico, una per ogni emozione: il primo vocabolario di brama.',
    },
    {
      '@type': 'CreativeWork',
      name: 'Disegni',
      artMedium: 'Pennarello, biro, china, matita su carta',
      description:
        'Il mondo grafico di brama: disegni in bianco e nero, contrappunto razionale del colore.',
    },
  ],
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <!-- ══ Apertura ══ -->
  <div class="page page-wide arch-top">
    <header class="arch-hero">
      <p class="eyebrow">Archivio</p>
      <h1>Ciò che ha formato il linguaggio</h1>
      <p class="lead">
        Qui non si vende: si consulta. L’archivio custodisce le origini di brama —
        le prime tele delle emozioni e il mondo grafico in bianco e nero da cui le
        opere continuano ad attingere.
      </p>
    </header>
  </div>

  <!-- ══ Archive Collection Emozioni: la costellazione ══ -->
  <section aria-labelledby="emozioni-title" class="emo-sky">
    <div class="emo-hangs emo-hangs-left" aria-hidden="true">
      <span class="hang hang-a">
        <i class="thread thread-a"></i>
        <i class="ink ink-stella"></i>
      </span>
      <span class="hang hang-b">
        <i class="thread thread-b"></i>
        <i class="ink ink-luna"></i>
      </span>
    </div>
    <div class="emo-hangs emo-hangs-right" aria-hidden="true">
      <span class="hang hang-c">
        <i class="thread thread-c"></i>
        <i class="ink ink-pianeta"></i>
      </span>
    </div>

    <div class="emo-sky-inner">
      <h2 id="emozioni-title">
        Archive Collection — Emozioni <span class="arch-year">(2021)</span>
      </h2>
      <p class="arch-meta" aria-label="Tecnica e anno della collezione">
        Acrilico su tela · 2021
      </p>
      <div class="arch-intro">
        <p>
          Il vocabolario di brama comincia qui: trentatré tele in acrilico, una per
          ogni emozione. Non temi ma titoli propri — ogni tela è il ritratto di uno
          stato, non la sua illustrazione. E la Vergogna esiste due volte, perché la
          stessa emozione non torna mai identica.
        </p>
      </div>

      <ol class="emo-field" role="list">
        {emozioni.map((w, i) => {
          const star = starOf(w.id);
          return (
            <li class={`emo-star m${star.mag}`} style={`--dy:${star.dy}`}>
              {hasContent(w) ? (
                <a class="emo-word" href={`/opera/${w.id}`}>
                  <sup class="emo-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</sup>
                  <span class="emo-name">{w.data.title}</span>
                </a>
              ) : (
                <span class="emo-word emo-word-still">
                  <sup class="emo-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</sup>
                  <span class="emo-name">{w.data.title}</span>
                </span>
              )}
            </li>
          );
        })}
      </ol>

      <p class="arch-note">
        <span class="arch-note-dot" aria-hidden="true"></span>
        L’archivio fotografico completo è in digitalizzazione: le tele torneranno
        visibili una a una.
      </p>
    </div>
  </section>

  <!-- ══ Disegni: carta e inchiostro ══ -->
  <section aria-labelledby="disegni-title" class="arch-paper">
    <div class="arch-paper-inner">
      <p class="eyebrow eyebrow-ink">Il mondo grafico</p>
      <h2 id="disegni-title">Disegni</h2>
      <div class="arch-intro arch-intro-ink">
        <p>
          Prima del colore, il tratto. Il disegno a pennarello è il contrappunto
          razionale di brama: carta e inchiostro, geometrie che ragionano dove
          l’acrilico sente. Occhi, ingranaggi, scacchiere, creature alate — un
          alfabeto che riaffiora dentro le opere e ai margini delle loro schede.
        </p>
      </div>

      <div class="paper-emblem ink" aria-hidden="true"></div>

      <h3 class="paper-sub">Le tavole</h3>
      <div class="plate-stage">
        {plates.map((p, i) => (
          <figure
            class={`plate-row${p.lead ? ' is-lead' : i % 2 === 1 ? ' row-odd' : ' row-even'}`}
          >
            <div class="plate-frame">
              <img
                src={p.src}
                alt={p.alt}
                width="2304"
                height="1296"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption class="plate-cap">
              <span class="plate-tav" aria-hidden="true">Tav. {String(i + 1).padStart(2, '0')}</span>
              {p.caption}
            </figcaption>
          </figure>
        ))}
      </div>

      {disegniRendered.length > 0 && (
        <div class="draw-sets">
          {disegniRendered.map(({ work, Content }) => (
            <article class="draw-set" aria-labelledby={`draw-${work.id}`}>
              <h3 id={`draw-${work.id}`}>{work.data.title}</h3>
              <p class="draw-materials">{work.data.materials.join(' · ')}</p>
              <div class="draw-prose">
                <Content />
              </div>
            </article>
          ))}
        </div>
      )}

      <section aria-labelledby="emblemi-title" class="emblems">
        <h3 id="emblemi-title">Emblemi minori</h3>
        <p>
          Alcuni disegni non occupano una tavola: si nascondono ai margini delle
          schede, firme minori dello stesso alfabeto.
        </p>
        <ul class="emblem-list" role="list">
          {emblems.map((e) => (
            <li>
              <span class="emblem-sign">{e.sign}</span>
              <span class="emblem-place">{e.place}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </section>

  <!-- ══ Chiusura ══ -->
  <nav class="arch-next" aria-label="Prosegui la visita">
    <div class="arch-next-inner">
      <p class="eyebrow">Prosegui</p>
      <p class="arch-next-lede">
        Nulla, qui, è in vendita. Le parole del metodo stanno nel manifesto; le
        opere che cercano casa, nello shop.
      </p>
      <div class="arch-next-links">
        <a href="/manifesto">Il manifesto <span aria-hidden="true">→</span></a>
        <a href="/shop">Lo shop <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </nav>
</Base>

<style>
  /* ── Asset a inchiostro: la tinta la dà il CSS, mai il file ── */
  .ink {
    display: block;
    background: currentColor;
    -webkit-mask: var(--ink-src) center / contain no-repeat;
    mask: var(--ink-src) center / contain no-repeat;
  }

  /* ── Apertura ── */
  .arch-top {
    padding-bottom: 72px;
  }
  .arch-hero {
    max-width: 720px;
  }

  /* ── Emozioni: il cielo ── */
  .emo-sky {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(120% 85% at 50% 0%, rgba(10, 20, 48, 0.85), rgba(10, 20, 48, 0) 62%),
      var(--bg);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 128px 24px 136px;
  }
  .emo-sky-inner {
    max-width: 1080px;
    margin: 0 auto;
    text-align: center;
  }
  .emo-sky h2 {
    font-family: var(--display);
    font-weight: 300;
    font-size: clamp(28px, 4.4vw, 46px);
    line-height: 1.1;
    margin-bottom: 18px;
  }
  .arch-year {
    color: var(--ink-mute);
    font-weight: 200;
  }
  .arch-meta {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-bottom: 24px;
  }
  .arch-intro {
    max-width: 620px;
    margin: 0 auto 72px;
  }
  .arch-intro p {
    line-height: 1.7;
    color: var(--ink-dim);
  }

  /* Gli appesi: grappoli asimmetrici agli angoli alti, mai al centro */
  .emo-hangs {
    position: absolute;
    top: -1px;
    display: flex;
    align-items: flex-start;
    gap: clamp(28px, 4vw, 56px);
    pointer-events: none;
  }
  .emo-hangs-left { left: clamp(16px, 7vw, 120px); }
  .emo-hangs-right { right: clamp(16px, 8vw, 140px); }
  .hang {
    display: flex;
    flex-direction: column;
    align-items: center;
    transform-origin: top center;
    animation: hang-sway 8s ease-in-out infinite alternate;
  }
  .hang-a { animation-duration: 7.2s; }
  .hang-b { animation-duration: 9.4s; animation-delay: -2.6s; }
  .hang-c { animation-duration: 8.1s; animation-delay: -1.2s; }
  @keyframes hang-sway {
    from { transform: rotate(-1.7deg); }
    to { transform: rotate(1.9deg); }
  }
  .thread {
    width: 1px;
    background: linear-gradient(rgba(74, 147, 230, 0.08), rgba(74, 147, 230, 0.5));
  }
  .thread-a { height: 86px; }
  .thread-b { height: 156px; }
  .thread-c { height: 118px; }
  .emo-hangs .ink {
    color: var(--accent);
    opacity: 0.55;
    margin-top: 4px;
  }
  .ink-stella { --ink-src: url('/viaggio/appeso-stella.webp'); width: 60px; height: 60px; }
  .ink-luna { --ink-src: url('/viaggio/appeso-luna.webp'); width: 44px; height: 44px; }
  .ink-pianeta { --ink-src: url('/viaggio/appeso-pianeta.webp'); width: 72px; height: 72px; }

  /* La costellazione tipografica */
  .emo-field {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    column-gap: clamp(30px, 5vw, 64px);
    row-gap: clamp(30px, 6vh, 54px);
    max-width: 980px;
    margin: 0 auto;
    padding: 8px 0 16px;
  }
  .emo-star {
    transform: translateY(calc(var(--dy, 0) * 1px));
  }
  .emo-word {
    display: inline-block;
    font-family: var(--display);
    font-weight: 300;
    line-height: 1.1;
    color: var(--ink);
    transition:
      color 0.35s cubic-bezier(0.32, 0.72, 0, 1),
      text-shadow 0.35s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .m0 .emo-word { font-size: clamp(17px, 1.9vw, 21px); }
  .m1 .emo-word { font-size: clamp(20px, 2.4vw, 27px); }
  .m2 .emo-word { font-size: clamp(25px, 3.2vw, 36px); }
  .m3 .emo-word { font-size: clamp(32px, 4.5vw, 50px); font-weight: 250; }
  a.emo-word:hover,
  a.emo-word:focus-visible {
    color: var(--accent);
    text-shadow: 0 0 26px rgba(74, 147, 230, 0.45);
  }
  a.emo-word:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }
  .emo-word-still {
    color: var(--ink);
    opacity: 0.78;
  }
  .emo-num {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--ink-mute);
    margin-right: 7px;
  }

  .arch-note {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 10px;
    margin-top: 72px;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-mute);
  }
  .arch-note-dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.7;
    transform: translateY(-1px);
    animation: arch-pulse 3.2s cubic-bezier(0.32, 0.72, 0, 1) infinite;
  }
  @keyframes arch-pulse {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 0.9; }
  }

  /* ── Disegni: banda carta ── */
  .arch-paper {
    background: var(--paper);
    color: var(--stroke);
    border-bottom: 1px solid var(--stroke);
  }
  .arch-paper-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 104px 24px 112px;
  }
  .eyebrow-ink {
    color: rgba(10, 10, 10, 0.55);
  }
  .arch-paper h2 {
    font-family: var(--display);
    font-weight: 300;
    font-size: clamp(30px, 5vw, 52px);
    line-height: 1.05;
    margin-bottom: 20px;
  }
  .arch-intro-ink {
    max-width: 640px;
    margin: 0 0 56px;
  }
  .arch-intro-ink p {
    color: rgba(10, 10, 10, 0.78);
  }

  /* Emblema-timbro: il pugnale-imbarcazione sulla corda, solo, con aria intorno */
  .paper-emblem {
    --ink-src: url('/viaggio/fregio-filigrana.webp');
    width: clamp(200px, 26vw, 290px);
    aspect-ratio: 1436 / 1024;
    margin: 0 auto 72px;
    color: var(--stroke);
    opacity: 0.85;
  }

  .paper-sub,
  .draw-set h3,
  .emblems h3 {
    font-family: var(--mono);
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(10, 10, 10, 0.6);
    margin-bottom: 20px;
  }

  /* Tavole: molto vuoto, cornici sottili, didascalie che fluttuano nel bianco */
  .plate-stage {
    margin: 48px 0 120px;
  }
  .plate-row {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 24px;
    align-items: end;
    margin: 0;
  }
  .plate-row + .plate-row {
    margin-top: clamp(80px, 14vh, 160px);
  }
  .plate-frame {
    background: #fff;
    border: 1px solid var(--stroke);
    padding: clamp(10px, 1.8vw, 24px);
    box-shadow: 0 32px 70px -52px rgba(10, 10, 10, 0.55);
  }
  .plate-frame img {
    width: 100%;
    height: auto;
  }
  .plate-cap {
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.7;
    color: rgba(10, 10, 10, 0.6);
  }
  .plate-tav {
    display: block;
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(10, 10, 10, 0.45);
    margin-bottom: 10px;
  }
  .plate-row.is-lead {
    align-items: start;
  }
  .is-lead .plate-frame {
    grid-column: 2 / span 10;
    grid-row: 1;
  }
  .is-lead .plate-cap {
    grid-column: 4 / span 6;
    grid-row: 2;
    text-align: center;
    margin-top: 20px;
  }
  .row-odd .plate-frame {
    grid-column: 1 / span 7;
    grid-row: 1;
  }
  .row-odd .plate-cap {
    grid-column: 9 / span 3;
    grid-row: 1;
    padding-bottom: 6px;
  }
  .row-even .plate-frame {
    grid-column: 6 / span 7;
    grid-row: 1;
  }
  .row-even .plate-cap {
    grid-column: 1 / span 4;
    grid-row: 1;
    text-align: right;
    padding-bottom: 6px;
  }

  /* Gruppi della collection disegni */
  .draw-sets {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    margin-bottom: 88px;
    align-items: start;
  }
  .draw-set {
    border-top: 1px solid var(--stroke);
    padding-top: 24px;
  }
  .draw-materials {
    font-family: var(--mono);
    font-size: 12px;
    color: rgba(10, 10, 10, 0.5);
    margin: -8px 0 18px;
  }
  .draw-prose :global(p) {
    font-family: var(--serif);
    font-size: 18px;
    line-height: 1.65;
    color: rgba(10, 10, 10, 0.85);
    margin-bottom: 14px;
  }
  .draw-prose :global(ul) {
    list-style: none;
    margin: 0 0 14px;
  }
  .draw-prose :global(li) {
    position: relative;
    padding-left: 22px;
    font-size: 15px;
    line-height: 1.65;
    color: rgba(10, 10, 10, 0.72);
    margin-bottom: 8px;
  }
  .draw-prose :global(li)::before {
    content: '—';
    position: absolute;
    left: 0;
    color: rgba(10, 10, 10, 0.45);
  }

  /* Emblemi minori */
  .emblems > p {
    max-width: 560px;
    line-height: 1.7;
    color: rgba(10, 10, 10, 0.78);
    margin-bottom: 24px;
  }
  .emblem-list {
    list-style: none;
    border-top: 1px solid var(--stroke);
  }
  .emblem-list li {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    align-items: baseline;
    justify-content: space-between;
    padding: 14px 0;
    border-bottom: 1px solid rgba(10, 10, 10, 0.25);
  }
  .emblem-sign {
    font-family: var(--display);
    font-weight: 300;
    font-size: clamp(18px, 2vw, 22px);
  }
  .emblem-place {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: rgba(10, 10, 10, 0.55);
  }

  /* ── Chiusura ── */
  .arch-next {
    padding: 96px 24px 112px;
  }
  .arch-next-inner {
    max-width: 880px;
    margin: 0 auto;
  }
  .arch-next-lede {
    font-family: var(--serif);
    font-size: clamp(19px, 2.6vw, 24px);
    line-height: 1.6;
    color: var(--ink-dim);
    max-width: 560px;
    margin-bottom: 40px;
  }
  .arch-next-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .arch-next-links a {
    display: inline-flex;
    align-items: baseline;
    gap: 14px;
    align-self: flex-start;
    font-family: var(--display);
    font-weight: 300;
