# brama v2 — variabili d'ambiente (impostarle su Vercel, MAI committare valori reali)

# --- Sito ---
PUBLIC_SITE_URL=https://brama.studio

# --- Stripe (TEST mode fino al go-live esplicito) ---
# Il sito legge da Stripe cosa è venduto: niente webhook né database.
STRIPE_SECRET_KEY=sk_test_xxx

# --- Richieste d'acquisto opere grandi (email dalla casella brama.studio via SMTP) ---
# Si invia dalla casella esistente riccardo@brama.studio: nessun account esterno,
# nessun record DNS. Impostazioni dal provider email del dominio.
#   SMTP_PORT: 465 (SSL) oppure 587 (STARTTLS).
#   SMTP_PASS: password della casella (o "password per app" se c'è la 2FA).
# REQUEST_NOTIFY: destinatari della notifica, separati da virgola (indirizzi reali
#   solo in locale / su Vercel, mai nel repo). Se assente → solo il brand.
# REQUEST_FROM: mittente (default: brama <riccardo@brama.studio>).
SMTP_HOST=smtps.example.com
SMTP_PORT=465
SMTP_USER=riccardo@brama.studio
SMTP_PASS=xxx
REQUEST_NOTIFY=riccardo@brama.studio,owner@example.com
REQUEST_FROM=brama <riccardo@brama.studio>
# In alternativa a SMTP: lasciare SMTP_HOST vuoto e usare Resend.
# RESEND_API_KEY=re_xxx

# --- Generazione/adattamento immagini (script asset del Viaggio, non serve al sito) ---
OPENAI_API_KEY=sk-proj-xxx
